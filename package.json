{
  "name": "sproto-open-world",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-prod-debug.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:balance": "vitest run --config vitest.balance.config.ts",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/camps.mjs && node tests/e2e/loading.mjs && node tests/e2e/mount.mjs && node tests/e2e/find-quest.mjs && node tests/e2e/rootdeep.mjs && node tests/e2e/unification.mjs",
    "test:e2e:unification": "node tests/e2e/unification.mjs",
    "gen:moves": "vite-node tools/gen-player-moves.ts --",
    "bake:world": "vite-node tools/bake-world.ts --",
    "bake:map": "node tools/bake-map.mjs",
    "import:assets": "node tools/import-sibling-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "build:pvp-sim": "node scripts/build-pvp-sim.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@metaverse/hub-sdk": "file:vendor/hub-sdk",
    "howler": "^2.2.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "meshoptimizer": "^1.1.1",
    "playwright": "1.63.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  }
}
